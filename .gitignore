# --- Secrets / env (NEVER commit; .env.example carries NAMES only) ---
.env
.env.*
!.env.example
*.local

# --- Node / build ---
node_modules
dist
*.tsbuildinfo
*.log

# --- Editor / OS ---
.vscode/*
.idea
.DS_Store

# --- Claude build-kit local state (the kit itself IS committed) ---
.claude/settings.local.json
.claude/checkpoints.log
.claude/CLAUDE.md.bak
.claude/CLAUDE.md.pre-kit

# --- Live catalogue snapshots (db:snapshot, P1.12): local evidence, never committed ---
ops-snapshots/

# --- Playwright (PLAN P2.4): run artefacts, never committed ---
test-results/
playwright-report/
blob-report/
